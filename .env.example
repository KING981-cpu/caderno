# Database Configuration
DB_HOST=db
DB_NAME=caderno
DB_USER=root
DB_PASS=${DB_PASSWORD}

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_NAME="Caderno Digital"
APP_VERSION=2.0.0

# Timezone
TIMEZONE=America/Sao_Paulo

# Logging
LOG_LEVEL=INFO
LOG_PATH=/var/log/caderno/app.log

# MySQL
MYSQL_ROOT_PASSWORD=${MYSQL_PASSWORD}
MYSQL_DATABASE=caderno
